<?xml version="1.0" encoding="UTF-8"?>
<!-- Simplified but structurally faithful PowerCenter 10.x repository export.
     Complexity: HIGH. Aggregator + Master Outer Joiner + connected and unconnected
     lookups + variable ports + DECODE(TRUE,...) + Router to error target. -->
<!DOCTYPE POWERMART SYSTEM "powrmart.dtd">
<POWERMART CREATION_DATE="03/14/2024 10:22:41" REPOSITORY_VERSION="186.95">
<REPOSITORY NAME="REP_INS_PROD" VERSION="186" CODEPAGE="UTF-8" DATABASETYPE="Microsoft SQL Server">
<FOLDER NAME="CLAIMS_DW" OWNER="etl_admin" SHARED="NOTSHARED" DESCRIPTION="Claims warehouse loads">

  <!-- ============================ SOURCES ============================ -->
  <SOURCE BUSINESSNAME="" DATABASETYPE="Microsoft SQL Server" DBDNAME="PolicyAdmin" NAME="CLAIM" OWNERNAME="dbo">
    <SOURCEFIELD DATATYPE="int" NAME="CLAIM_ID" NULLABLE="NOTNULL" KEYTYPE="PRIMARY KEY" PRECISION="10" SCALE="0"/>
    <SOURCEFIELD DATATYPE="varchar" NAME="CLAIM_NUMBER" NULLABLE="NOTNULL" KEYTYPE="NOT A KEY" PRECISION="20" SCALE="0"/>
    <SOURCEFIELD DATATYPE="int" NAME="POLICY_ID" NULLABLE="NULL" KEYTYPE="NOT A KEY" PRECISION="10" SCALE="0"/>
    <SOURCEFIELD DATATYPE="int" NAME="HANDLING_AGENT_ID" NULLABLE="NULL" KEYTYPE="NOT A KEY" PRECISION="10" SCALE="0"/>
    <SOURCEFIELD DATATYPE="date" NAME="LOSS_DATE" NULLABLE="NOTNULL" KEYTYPE="NOT A KEY" PRECISION="10" SCALE="0"/>
    <SOURCEFIELD DATATYPE="date" NAME="REPORTED_DATE" NULLABLE="NOTNULL" KEYTYPE="NOT A KEY" PRECISION="10" SCALE="0"/>
    <SOURCEFIELD DATATYPE="date" NAME="CLOSED_DATE" NULLABLE="NULL" KEYTYPE="NOT A KEY" PRECISION="10" SCALE="0"/>
    <SOURCEFIELD DATATYPE="varchar" NAME="CLAIM_STATUS" NULLABLE="NOTNULL" KEYTYPE="NOT A KEY" PRECISION="10" SCALE="0"/>
    <SOURCEFIELD DATATYPE="varchar" NAME="LOSS_TYPE" NULLABLE="NOTNULL" KEYTYPE="NOT A KEY" PRECISION="20" SCALE="0"/>
    <SOURCEFIELD DATATYPE="decimal" NAME="RESERVE_AMOUNT" NULLABLE="NOTNULL" KEYTYPE="NOT A KEY" PRECISION="12" SCALE="2"/>
    <SOURCEFIELD DATATYPE="bit" NAME="IS_DELETED" NULLABLE="NOTNULL" KEYTYPE="NOT A KEY" PRECISION="1" SCALE="0"/>
  </SOURCE>

  <SOURCE BUSINESSNAME="" DATABASETYPE="Microsoft SQL Server" DBDNAME="PolicyAdmin" NAME="CLAIM_PAYMENT" OWNERNAME="dbo">
    <SOURCEFIELD DATATYPE="int" NAME="PAYMENT_ID" NULLABLE="NOTNULL" KEYTYPE="PRIMARY KEY" PRECISION="10" SCALE="0"/>
    <SOURCEFIELD DATATYPE="int" NAME="CLAIM_ID" NULLABLE="NOTNULL" KEYTYPE="FOREIGN KEY" PRECISION="10" SCALE="0"/>
    <SOURCEFIELD DATATYPE="decimal" NAME="PAYMENT_AMOUNT" NULLABLE="NOTNULL" KEYTYPE="NOT A KEY" PRECISION="12" SCALE="2"/>
    <SOURCEFIELD DATATYPE="varchar" NAME="PAYMENT_TYPE" NULLABLE="NOTNULL" KEYTYPE="NOT A KEY" PRECISION="10" SCALE="0"/>
    <SOURCEFIELD DATATYPE="bit" NAME="IS_VOID" NULLABLE="NOTNULL" KEYTYPE="NOT A KEY" PRECISION="1" SCALE="0"/>
  </SOURCE>

  <!-- ============================ TARGETS ============================ -->
  <TARGET BUSINESSNAME="" DATABASETYPE="Microsoft SQL Server" NAME="FACT_CLAIMS" OWNERNAME="edw">
    <TARGETFIELD DATATYPE="int" NAME="CLAIM_ID" NULLABLE="NOTNULL" KEYTYPE="PRIMARY KEY" PRECISION="10" SCALE="0"/>
    <TARGETFIELD DATATYPE="varchar" NAME="CLAIM_NUMBER" NULLABLE="NOTNULL" KEYTYPE="NOT A KEY" PRECISION="20" SCALE="0"/>
    <TARGETFIELD DATATYPE="int" NAME="POLICY_KEY" NULLABLE="NOTNULL" KEYTYPE="NOT A KEY" PRECISION="10" SCALE="0"/>
    <TARGETFIELD DATATYPE="int" NAME="AGENT_KEY" NULLABLE="NOTNULL" KEYTYPE="NOT A KEY" PRECISION="10" SCALE="0"/>
    <TARGETFIELD DATATYPE="int" NAME="LOSS_DATE_KEY" NULLABLE="NOTNULL" KEYTYPE="NOT A KEY" PRECISION="10" SCALE="0"/>
    <TARGETFIELD DATATYPE="int" NAME="REPORTED_DATE_KEY" NULLABLE="NOTNULL" KEYTYPE="NOT A KEY" PRECISION="10" SCALE="0"/>
    <TARGETFIELD DATATYPE="varchar" NAME="CLAIM_STATUS" NULLABLE="NOTNULL" KEYTYPE="NOT A KEY" PRECISION="10" SCALE="0"/>
    <TARGETFIELD DATATYPE="varchar" NAME="LOSS_TYPE" NULLABLE="NOTNULL" KEYTYPE="NOT A KEY" PRECISION="20" SCALE="0"/>
    <TARGETFIELD DATATYPE="int" NAME="DAYS_TO_REPORT" NULLABLE="NOTNULL" KEYTYPE="NOT A KEY" PRECISION="10" SCALE="0"/>
    <TARGETFIELD DATATYPE="int" NAME="DAYS_OPEN" NULLABLE="NULL" KEYTYPE="NOT A KEY" PRECISION="10" SCALE="0"/>
    <TARGETFIELD DATATYPE="decimal" NAME="RESERVE_AMOUNT" NULLABLE="NOTNULL" KEYTYPE="NOT A KEY" PRECISION="12" SCALE="2"/>
    <TARGETFIELD DATATYPE="decimal" NAME="TOTAL_PAID_INDEMNITY" NULLABLE="NOTNULL" KEYTYPE="NOT A KEY" PRECISION="14" SCALE="2"/>
    <TARGETFIELD DATATYPE="decimal" NAME="TOTAL_PAID_EXPENSE" NULLABLE="NOTNULL" KEYTYPE="NOT A KEY" PRECISION="14" SCALE="2"/>
    <TARGETFIELD DATATYPE="decimal" NAME="TOTAL_PAID" NULLABLE="NOTNULL" KEYTYPE="NOT A KEY" PRECISION="14" SCALE="2"/>
    <TARGETFIELD DATATYPE="char" NAME="IS_LARGE_LOSS" NULLABLE="NOTNULL" KEYTYPE="NOT A KEY" PRECISION="1" SCALE="0"/>
    <TARGETFIELD DATATYPE="datetime2" NAME="DW_LOAD_TS" NULLABLE="NOTNULL" KEYTYPE="NOT A KEY" PRECISION="27" SCALE="7"/>
  </TARGET>

  <TARGET BUSINESSNAME="" DATABASETYPE="Microsoft SQL Server" NAME="ERR_CLAIMS" OWNERNAME="edw">
    <TARGETFIELD DATATYPE="int" NAME="CLAIM_ID" NULLABLE="NOTNULL" KEYTYPE="NOT A KEY" PRECISION="10" SCALE="0"/>
    <TARGETFIELD DATATYPE="varchar" NAME="CLAIM_NUMBER" NULLABLE="NOTNULL" KEYTYPE="NOT A KEY" PRECISION="20" SCALE="0"/>
    <TARGETFIELD DATATYPE="int" NAME="POLICY_ID" NULLABLE="NULL" KEYTYPE="NOT A KEY" PRECISION="10" SCALE="0"/>
    <TARGETFIELD DATATYPE="varchar" NAME="ERROR_REASON" NULLABLE="NOTNULL" KEYTYPE="NOT A KEY" PRECISION="100" SCALE="0"/>
    <TARGETFIELD DATATYPE="datetime2" NAME="DW_LOAD_TS" NULLABLE="NOTNULL" KEYTYPE="NOT A KEY" PRECISION="27" SCALE="7"/>
  </TARGET>

  <!-- ===================== REUSABLE: UNCONNECTED LOOKUP ===================== -->
  <TRANSFORMATION NAME="LKP_DIM_AGENT" TYPE="Lookup Procedure" REUSABLE="YES" DESCRIPTION="Unconnected: returns AGENT_KEY for an AGENT_ID">
    <TRANSFORMFIELD DATATYPE="integer" NAME="IN_AGENT_ID" PORTTYPE="INPUT" PRECISION="10" SCALE="0"/>
    <TRANSFORMFIELD DATATYPE="integer" NAME="AGENT_ID" PORTTYPE="LOOKUP" PRECISION="10" SCALE="0"/>
    <TRANSFORMFIELD DATATYPE="integer" NAME="AGENT_KEY" PORTTYPE="LOOKUP/OUTPUT/RETURN" PRECISION="10" SCALE="0"/>
    <TABLEATTRIBUTE NAME="Lookup table name" VALUE="DIM_AGENT"/>
    <TABLEATTRIBUTE NAME="Lookup condition" VALUE="AGENT_ID = IN_AGENT_ID"/>
    <TABLEATTRIBUTE NAME="Lookup policy on multiple match" VALUE="Use First Value"/>
    <TABLEATTRIBUTE NAME="Connection Information" VALUE="$Target"/>
    <TABLEATTRIBUTE NAME="Lookup caching enabled" VALUE="YES"/>
  </TRANSFORMATION>

  <!-- ============================== MAPPING ============================== -->
  <MAPPING NAME="m_LOAD_FACT_CLAIMS" ISVALID="YES" DESCRIPTION="Loads FACT_CLAIMS; claims without a current policy go to ERR_CLAIMS">

    <TRANSFORMATION NAME="SQ_CLAIM" TYPE="Source Qualifier" REUSABLE="NO">
      <TRANSFORMFIELD DATATYPE="integer" NAME="CLAIM_ID" PORTTYPE="INPUT/OUTPUT" PRECISION="10" SCALE="0"/>
      <TRANSFORMFIELD DATATYPE="string" NAME="CLAIM_NUMBER" PORTTYPE="INPUT/OUTPUT" PRECISION="20" SCALE="0"/>
      <TRANSFORMFIELD DATATYPE="integer" NAME="POLICY_ID" PORTTYPE="INPUT/OUTPUT" PRECISION="10" SCALE="0"/>
      <TRANSFORMFIELD DATATYPE="integer" NAME="HANDLING_AGENT_ID" PORTTYPE="INPUT/OUTPUT" PRECISION="10" SCALE="0"/>
      <TRANSFORMFIELD DATATYPE="date/time" NAME="LOSS_DATE" PORTTYPE="INPUT/OUTPUT" PRECISION="29" SCALE="9"/>
      <TRANSFORMFIELD DATATYPE="date/time" NAME="REPORTED_DATE" PORTTYPE="INPUT/OUTPUT" PRECISION="29" SCALE="9"/>
      <TRANSFORMFIELD DATATYPE="date/time" NAME="CLOSED_DATE" PORTTYPE="INPUT/OUTPUT" PRECISION="29" SCALE="9"/>
      <TRANSFORMFIELD DATATYPE="string" NAME="CLAIM_STATUS" PORTTYPE="INPUT/OUTPUT" PRECISION="10" SCALE="0"/>
      <TRANSFORMFIELD DATATYPE="string" NAME="LOSS_TYPE" PORTTYPE="INPUT/OUTPUT" PRECISION="20" SCALE="0"/>
      <TRANSFORMFIELD DATATYPE="decimal" NAME="RESERVE_AMOUNT" PORTTYPE="INPUT/OUTPUT" PRECISION="12" SCALE="2"/>
      <TABLEATTRIBUTE NAME="Sql Query" VALUE=""/>
      <TABLEATTRIBUTE NAME="Source Filter" VALUE="CLAIM.IS_DELETED = 0"/>
      <TABLEATTRIBUTE NAME="Select Distinct" VALUE="NO"/>
    </TRANSFORMATION>

    <TRANSFORMATION NAME="SQ_CLAIM_PAYMENT" TYPE="Source Qualifier" REUSABLE="NO">
      <TRANSFORMFIELD DATATYPE="integer" NAME="CLAIM_ID" PORTTYPE="INPUT/OUTPUT" PRECISION="10" SCALE="0"/>
      <TRANSFORMFIELD DATATYPE="decimal" NAME="PAYMENT_AMOUNT" PORTTYPE="INPUT/OUTPUT" PRECISION="12" SCALE="2"/>
      <TRANSFORMFIELD DATATYPE="string" NAME="PAYMENT_TYPE" PORTTYPE="INPUT/OUTPUT" PRECISION="10" SCALE="0"/>
      <TABLEATTRIBUTE NAME="Sql Query" VALUE=""/>
      <TABLEATTRIBUTE NAME="Source Filter" VALUE="CLAIM_PAYMENT.IS_VOID = 0"/>
    </TRANSFORMATION>

    <TRANSFORMATION NAME="AGG_PAYMENTS" TYPE="Aggregator" REUSABLE="NO">
      <TRANSFORMFIELD DATATYPE="integer" NAME="CLAIM_ID" PORTTYPE="INPUT/OUTPUT" EXPRESSIONTYPE="GROUPBY" PRECISION="10" SCALE="0"/>
      <TRANSFORMFIELD DATATYPE="decimal" NAME="PAYMENT_AMOUNT" PORTTYPE="INPUT" PRECISION="12" SCALE="2"/>
      <TRANSFORMFIELD DATATYPE="string" NAME="PAYMENT_TYPE" PORTTYPE="INPUT" PRECISION="10" SCALE="0"/>
      <TRANSFORMFIELD DATATYPE="decimal" NAME="TOTAL_INDEMNITY" PORTTYPE="OUTPUT" PRECISION="14" SCALE="2"
        EXPRESSION="SUM(IIF(PAYMENT_TYPE = 'INDEMNITY', PAYMENT_AMOUNT, 0))"/>
      <TRANSFORMFIELD DATATYPE="decimal" NAME="TOTAL_EXPENSE" PORTTYPE="OUTPUT" PRECISION="14" SCALE="2"
        EXPRESSION="SUM(IIF(PAYMENT_TYPE = 'EXPENSE', PAYMENT_AMOUNT, 0))"/>
      <TABLEATTRIBUTE NAME="Sorted Input" VALUE="NO"/>
    </TRANSFORMATION>

    <!-- MASTER = AGG_PAYMENTS (ports marked MASTER), DETAIL = SQ_CLAIM.
         "Master Outer Join" keeps ALL DETAIL rows => claims LEFT JOIN payments. -->
    <TRANSFORMATION NAME="JNR_CLAIM_PAYMENTS" TYPE="Joiner" REUSABLE="NO">
      <TRANSFORMFIELD DATATYPE="integer" NAME="CLAIM_ID_M" PORTTYPE="INPUT/OUTPUT/MASTER" PRECISION="10" SCALE="0"/>
      <TRANSFORMFIELD DATATYPE="decimal" NAME="TOTAL_INDEMNITY" PORTTYPE="INPUT/OUTPUT/MASTER" PRECISION="14" SCALE="2"/>
      <TRANSFORMFIELD DATATYPE="decimal" NAME="TOTAL_EXPENSE" PORTTYPE="INPUT/OUTPUT/MASTER" PRECISION="14" SCALE="2"/>
      <TRANSFORMFIELD DATATYPE="integer" NAME="CLAIM_ID" PORTTYPE="INPUT/OUTPUT" PRECISION="10" SCALE="0"/>
      <TRANSFORMFIELD DATATYPE="string" NAME="CLAIM_NUMBER" PORTTYPE="INPUT/OUTPUT" PRECISION="20" SCALE="0"/>
      <TRANSFORMFIELD DATATYPE="integer" NAME="POLICY_ID" PORTTYPE="INPUT/OUTPUT" PRECISION="10" SCALE="0"/>
      <TRANSFORMFIELD DATATYPE="integer" NAME="HANDLING_AGENT_ID" PORTTYPE="INPUT/OUTPUT" PRECISION="10" SCALE="0"/>
      <TRANSFORMFIELD DATATYPE="date/time" NAME="LOSS_DATE" PORTTYPE="INPUT/OUTPUT" PRECISION="29" SCALE="9"/>
      <TRANSFORMFIELD DATATYPE="date/time" NAME="REPORTED_DATE" PORTTYPE="INPUT/OUTPUT" PRECISION="29" SCALE="9"/>
      <TRANSFORMFIELD DATATYPE="date/time" NAME="CLOSED_DATE" PORTTYPE="INPUT/OUTPUT" PRECISION="29" SCALE="9"/>
      <TRANSFORMFIELD DATATYPE="string" NAME="CLAIM_STATUS" PORTTYPE="INPUT/OUTPUT" PRECISION="10" SCALE="0"/>
      <TRANSFORMFIELD DATATYPE="string" NAME="LOSS_TYPE" PORTTYPE="INPUT/OUTPUT" PRECISION="20" SCALE="0"/>
      <TRANSFORMFIELD DATATYPE="decimal" NAME="RESERVE_AMOUNT" PORTTYPE="INPUT/OUTPUT" PRECISION="12" SCALE="2"/>
      <TABLEATTRIBUTE NAME="Join Condition" VALUE="CLAIM_ID_M = CLAIM_ID"/>
      <TABLEATTRIBUTE NAME="Join Type" VALUE="Master Outer Join"/>
    </TRANSFORMATION>

    <TRANSFORMATION NAME="LKP_DIM_POLICY" TYPE="Lookup Procedure" REUSABLE="NO">
      <TRANSFORMFIELD DATATYPE="integer" NAME="IN_POLICY_ID" PORTTYPE="INPUT" PRECISION="10" SCALE="0"/>
      <TRANSFORMFIELD DATATYPE="integer" NAME="POLICY_ID" PORTTYPE="LOOKUP" PRECISION="10" SCALE="0"/>
      <TRANSFORMFIELD DATATYPE="integer" NAME="POLICY_KEY" PORTTYPE="LOOKUP/OUTPUT" PRECISION="10" SCALE="0"/>
      <TABLEATTRIBUTE NAME="Lookup table name" VALUE="DIM_POLICY"/>
      <TABLEATTRIBUTE NAME="Lookup condition" VALUE="POLICY_ID = IN_POLICY_ID"/>
      <TABLEATTRIBUTE NAME="Lookup Source Filter" VALUE="DIM_POLICY.IS_CURRENT = 1"/>
      <TABLEATTRIBUTE NAME="Lookup policy on multiple match" VALUE="Use Any Value"/>
      <TABLEATTRIBUTE NAME="Connection Information" VALUE="$Target"/>
    </TRANSFORMATION>

    <TRANSFORMATION NAME="EXP_CLAIM_METRICS" TYPE="Expression" REUSABLE="NO">
      <TRANSFORMFIELD DATATYPE="integer" NAME="CLAIM_ID" PORTTYPE="INPUT/OUTPUT" EXPRESSION="CLAIM_ID" PRECISION="10" SCALE="0"/>
      <TRANSFORMFIELD DATATYPE="string" NAME="CLAIM_NUMBER" PORTTYPE="INPUT/OUTPUT" EXPRESSION="CLAIM_NUMBER" PRECISION="20" SCALE="0"/>
      <TRANSFORMFIELD DATATYPE="integer" NAME="POLICY_ID" PORTTYPE="INPUT/OUTPUT" EXPRESSION="POLICY_ID" PRECISION="10" SCALE="0"/>
      <TRANSFORMFIELD DATATYPE="integer" NAME="POLICY_KEY" PORTTYPE="INPUT/OUTPUT" EXPRESSION="POLICY_KEY" PRECISION="10" SCALE="0"/>
      <TRANSFORMFIELD DATATYPE="integer" NAME="HANDLING_AGENT_ID" PORTTYPE="INPUT" PRECISION="10" SCALE="0"/>
      <TRANSFORMFIELD DATATYPE="date/time" NAME="LOSS_DATE" PORTTYPE="INPUT" PRECISION="29" SCALE="9"/>
      <TRANSFORMFIELD DATATYPE="date/time" NAME="REPORTED_DATE" PORTTYPE="INPUT" PRECISION="29" SCALE="9"/>
      <TRANSFORMFIELD DATATYPE="date/time" NAME="CLOSED_DATE" PORTTYPE="INPUT" PRECISION="29" SCALE="9"/>
      <TRANSFORMFIELD DATATYPE="string" NAME="CLAIM_STATUS" PORTTYPE="INPUT" PRECISION="10" SCALE="0"/>
      <TRANSFORMFIELD DATATYPE="string" NAME="LOSS_TYPE" PORTTYPE="INPUT/OUTPUT" EXPRESSION="LOSS_TYPE" PRECISION="20" SCALE="0"/>
      <TRANSFORMFIELD DATATYPE="decimal" NAME="RESERVE_AMOUNT" PORTTYPE="INPUT/OUTPUT" EXPRESSION="RESERVE_AMOUNT" PRECISION="12" SCALE="2"/>
      <TRANSFORMFIELD DATATYPE="decimal" NAME="TOTAL_INDEMNITY" PORTTYPE="INPUT" PRECISION="14" SCALE="2"/>
      <TRANSFORMFIELD DATATYPE="decimal" NAME="TOTAL_EXPENSE" PORTTYPE="INPUT" PRECISION="14" SCALE="2"/>

      <!-- Variable ports are evaluated top-to-bottom, before output ports -->
      <TRANSFORMFIELD DATATYPE="decimal" NAME="V_INDEMNITY" PORTTYPE="LOCAL VARIABLE" PRECISION="14" SCALE="2"
        EXPRESSION="IIF(ISNULL(TOTAL_INDEMNITY), 0, TOTAL_INDEMNITY)"/>
      <TRANSFORMFIELD DATATYPE="decimal" NAME="V_EXPENSE" PORTTYPE="LOCAL VARIABLE" PRECISION="14" SCALE="2"
        EXPRESSION="IIF(ISNULL(TOTAL_EXPENSE), 0, TOTAL_EXPENSE)"/>
      <TRANSFORMFIELD DATATYPE="decimal" NAME="V_TOTAL_PAID" PORTTYPE="LOCAL VARIABLE" PRECISION="14" SCALE="2"
        EXPRESSION="V_INDEMNITY + V_EXPENSE"/>

      <TRANSFORMFIELD DATATYPE="integer" NAME="O_AGENT_KEY" PORTTYPE="OUTPUT" PRECISION="10" SCALE="0"
        EXPRESSION="IIF(ISNULL(HANDLING_AGENT_ID), -1, IIF(ISNULL(:LKP.LKP_DIM_AGENT(HANDLING_AGENT_ID)), -1, :LKP.LKP_DIM_AGENT(HANDLING_AGENT_ID)))"/>
      <TRANSFORMFIELD DATATYPE="integer" NAME="O_LOSS_DATE_KEY" PORTTYPE="OUTPUT" PRECISION="10" SCALE="0"
        EXPRESSION="TO_INTEGER(TO_CHAR(LOSS_DATE, 'YYYYMMDD'))"/>
      <TRANSFORMFIELD DATATYPE="integer" NAME="O_REPORTED_DATE_KEY" PORTTYPE="OUTPUT" PRECISION="10" SCALE="0"
        EXPRESSION="TO_INTEGER(TO_CHAR(REPORTED_DATE, 'YYYYMMDD'))"/>
      <TRANSFORMFIELD DATATYPE="string" NAME="O_CLAIM_STATUS" PORTTYPE="OUTPUT" PRECISION="10" SCALE="0"
        EXPRESSION="LTRIM(RTRIM(UPPER(CLAIM_STATUS)))"/>
      <TRANSFORMFIELD DATATYPE="integer" NAME="O_DAYS_TO_REPORT" PORTTYPE="OUTPUT" PRECISION="10" SCALE="0"
        EXPRESSION="DATE_DIFF(REPORTED_DATE, LOSS_DATE, 'DD')"/>
      <TRANSFORMFIELD DATATYPE="integer" NAME="O_DAYS_OPEN" PORTTYPE="OUTPUT" PRECISION="10" SCALE="0"
        EXPRESSION="IIF(IN(CLAIM_STATUS, 'CLOSED', 'DENIED'), DATE_DIFF(CLOSED_DATE, REPORTED_DATE, 'DD'), NULL)"/>
      <TRANSFORMFIELD DATATYPE="decimal" NAME="O_TOTAL_PAID_INDEMNITY" PORTTYPE="OUTPUT" PRECISION="14" SCALE="2" EXPRESSION="V_INDEMNITY"/>
      <TRANSFORMFIELD DATATYPE="decimal" NAME="O_TOTAL_PAID_EXPENSE" PORTTYPE="OUTPUT" PRECISION="14" SCALE="2" EXPRESSION="V_EXPENSE"/>
      <TRANSFORMFIELD DATATYPE="decimal" NAME="O_TOTAL_PAID" PORTTYPE="OUTPUT" PRECISION="14" SCALE="2" EXPRESSION="V_TOTAL_PAID"/>
      <TRANSFORMFIELD DATATYPE="string" NAME="O_IS_LARGE_LOSS" PORTTYPE="OUTPUT" PRECISION="1" SCALE="0"
        EXPRESSION="DECODE(TRUE, V_TOTAL_PAID + RESERVE_AMOUNT &gt;= 100000, 'Y', LOSS_TYPE = 'LIABILITY' AND RESERVE_AMOUNT &gt;= 50000, 'Y', 'N')"/>
      <TRANSFORMFIELD DATATYPE="date/time" NAME="O_DW_LOAD_TS" PORTTYPE="OUTPUT" PRECISION="29" SCALE="9" EXPRESSION="SESSSTARTTIME"/>
    </TRANSFORMATION>

    <!-- Router: a row is evaluated against EVERY group (not first-match) -->
    <TRANSFORMATION NAME="RTR_POLICY_CHECK" TYPE="Router" REUSABLE="NO">
      <GROUP NAME="INPUT" TYPE="INPUT" ORDER="1"/>
      <GROUP NAME="VALID" TYPE="OUTPUT" ORDER="2" EXPRESSION="NOT ISNULL(POLICY_KEY)"/>
      <GROUP NAME="POLICY_NOT_FOUND" TYPE="OUTPUT" ORDER="3" EXPRESSION="ISNULL(POLICY_KEY)"/>
      <GROUP NAME="DEFAULT1" TYPE="OUTPUT/DEFAULT" ORDER="4"/>
    </TRANSFORMATION>

    <TRANSFORMATION NAME="EXP_ERROR_REASON" TYPE="Expression" REUSABLE="NO">
      <TRANSFORMFIELD DATATYPE="integer" NAME="POLICY_ID" PORTTYPE="INPUT/OUTPUT" EXPRESSION="POLICY_ID" PRECISION="10" SCALE="0"/>
      <!-- NOTE: Informatica treats NULL as empty string in || concatenation -->
      <TRANSFORMFIELD DATATYPE="string" NAME="O_ERROR_REASON" PORTTYPE="OUTPUT" PRECISION="100" SCALE="0"
        EXPRESSION="'POLICY_NOT_FOUND:' || TO_CHAR(POLICY_ID)"/>
    </TRANSFORMATION>

    <!-- Instances -->
    <INSTANCE NAME="CLAIM" TRANSFORMATION_NAME="CLAIM" TRANSFORMATION_TYPE="Source Definition" TYPE="SOURCE" DBDNAME="PolicyAdmin"/>
    <INSTANCE NAME="CLAIM_PAYMENT" TRANSFORMATION_NAME="CLAIM_PAYMENT" TRANSFORMATION_TYPE="Source Definition" TYPE="SOURCE" DBDNAME="PolicyAdmin"/>
    <INSTANCE NAME="SQ_CLAIM" TRANSFORMATION_NAME="SQ_CLAIM" TRANSFORMATION_TYPE="Source Qualifier" TYPE="TRANSFORMATION"/>
    <INSTANCE NAME="SQ_CLAIM_PAYMENT" TRANSFORMATION_NAME="SQ_CLAIM_PAYMENT" TRANSFORMATION_TYPE="Source Qualifier" TYPE="TRANSFORMATION"/>
    <INSTANCE NAME="AGG_PAYMENTS" TRANSFORMATION_NAME="AGG_PAYMENTS" TRANSFORMATION_TYPE="Aggregator" TYPE="TRANSFORMATION"/>
    <INSTANCE NAME="JNR_CLAIM_PAYMENTS" TRANSFORMATION_NAME="JNR_CLAIM_PAYMENTS" TRANSFORMATION_TYPE="Joiner" TYPE="TRANSFORMATION"/>
    <INSTANCE NAME="LKP_DIM_POLICY" TRANSFORMATION_NAME="LKP_DIM_POLICY" TRANSFORMATION_TYPE="Lookup Procedure" TYPE="TRANSFORMATION"/>
    <INSTANCE NAME="LKP_DIM_AGENT" TRANSFORMATION_NAME="LKP_DIM_AGENT" TRANSFORMATION_TYPE="Lookup Procedure" TYPE="TRANSFORMATION" REUSABLE="YES"/>
    <INSTANCE NAME="EXP_CLAIM_METRICS" TRANSFORMATION_NAME="EXP_CLAIM_METRICS" TRANSFORMATION_TYPE="Expression" TYPE="TRANSFORMATION"/>
    <INSTANCE NAME="RTR_POLICY_CHECK" TRANSFORMATION_NAME="RTR_POLICY_CHECK" TRANSFORMATION_TYPE="Router" TYPE="TRANSFORMATION"/>
    <INSTANCE NAME="EXP_ERROR_REASON" TRANSFORMATION_NAME="EXP_ERROR_REASON" TRANSFORMATION_TYPE="Expression" TYPE="TRANSFORMATION"/>
    <INSTANCE NAME="FACT_CLAIMS" TRANSFORMATION_NAME="FACT_CLAIMS" TRANSFORMATION_TYPE="Target Definition" TYPE="TARGET"/>
    <INSTANCE NAME="ERR_CLAIMS" TRANSFORMATION_NAME="ERR_CLAIMS" TRANSFORMATION_TYPE="Target Definition" TYPE="TARGET"/>

    <!-- Connectors (abridged to representative ports per edge) -->
    <CONNECTOR FROMINSTANCE="CLAIM" FROMINSTANCETYPE="Source Definition" FROMFIELD="CLAIM_ID" TOINSTANCE="SQ_CLAIM" TOINSTANCETYPE="Source Qualifier" TOFIELD="CLAIM_ID"/>
    <CONNECTOR FROMINSTANCE="CLAIM_PAYMENT" FROMINSTANCETYPE="Source Definition" FROMFIELD="CLAIM_ID" TOINSTANCE="SQ_CLAIM_PAYMENT" TOINSTANCETYPE="Source Qualifier" TOFIELD="CLAIM_ID"/>
    <CONNECTOR FROMINSTANCE="SQ_CLAIM_PAYMENT" FROMINSTANCETYPE="Source Qualifier" FROMFIELD="CLAIM_ID" TOINSTANCE="AGG_PAYMENTS" TOINSTANCETYPE="Aggregator" TOFIELD="CLAIM_ID"/>
    <CONNECTOR FROMINSTANCE="SQ_CLAIM_PAYMENT" FROMINSTANCETYPE="Source Qualifier" FROMFIELD="PAYMENT_AMOUNT" TOINSTANCE="AGG_PAYMENTS" TOINSTANCETYPE="Aggregator" TOFIELD="PAYMENT_AMOUNT"/>
    <CONNECTOR FROMINSTANCE="SQ_CLAIM_PAYMENT" FROMINSTANCETYPE="Source Qualifier" FROMFIELD="PAYMENT_TYPE" TOINSTANCE="AGG_PAYMENTS" TOINSTANCETYPE="Aggregator" TOFIELD="PAYMENT_TYPE"/>
    <CONNECTOR FROMINSTANCE="AGG_PAYMENTS" FROMINSTANCETYPE="Aggregator" FROMFIELD="CLAIM_ID" TOINSTANCE="JNR_CLAIM_PAYMENTS" TOINSTANCETYPE="Joiner" TOFIELD="CLAIM_ID_M"/>
    <CONNECTOR FROMINSTANCE="AGG_PAYMENTS" FROMINSTANCETYPE="Aggregator" FROMFIELD="TOTAL_INDEMNITY" TOINSTANCE="JNR_CLAIM_PAYMENTS" TOINSTANCETYPE="Joiner" TOFIELD="TOTAL_INDEMNITY"/>
    <CONNECTOR FROMINSTANCE="AGG_PAYMENTS" FROMINSTANCETYPE="Aggregator" FROMFIELD="TOTAL_EXPENSE" TOINSTANCE="JNR_CLAIM_PAYMENTS" TOINSTANCETYPE="Joiner" TOFIELD="TOTAL_EXPENSE"/>
    <CONNECTOR FROMINSTANCE="SQ_CLAIM" FROMINSTANCETYPE="Source Qualifier" FROMFIELD="CLAIM_ID" TOINSTANCE="JNR_CLAIM_PAYMENTS" TOINSTANCETYPE="Joiner" TOFIELD="CLAIM_ID"/>
    <CONNECTOR FROMINSTANCE="JNR_CLAIM_PAYMENTS" FROMINSTANCETYPE="Joiner" FROMFIELD="POLICY_ID" TOINSTANCE="LKP_DIM_POLICY" TOINSTANCETYPE="Lookup Procedure" TOFIELD="IN_POLICY_ID"/>
    <CONNECTOR FROMINSTANCE="LKP_DIM_POLICY" FROMINSTANCETYPE="Lookup Procedure" FROMFIELD="POLICY_KEY" TOINSTANCE="EXP_CLAIM_METRICS" TOINSTANCETYPE="Expression" TOFIELD="POLICY_KEY"/>
    <CONNECTOR FROMINSTANCE="JNR_CLAIM_PAYMENTS" FROMINSTANCETYPE="Joiner" FROMFIELD="CLAIM_ID" TOINSTANCE="EXP_CLAIM_METRICS" TOINSTANCETYPE="Expression" TOFIELD="CLAIM_ID"/>
    <CONNECTOR FROMINSTANCE="JNR_CLAIM_PAYMENTS" FROMINSTANCETYPE="Joiner" FROMFIELD="TOTAL_INDEMNITY" TOINSTANCE="EXP_CLAIM_METRICS" TOINSTANCETYPE="Expression" TOFIELD="TOTAL_INDEMNITY"/>
    <CONNECTOR FROMINSTANCE="EXP_CLAIM_METRICS" FROMINSTANCETYPE="Expression" FROMFIELD="POLICY_KEY" TOINSTANCE="RTR_POLICY_CHECK" TOINSTANCETYPE="Router" TOFIELD="POLICY_KEY"/>
    <CONNECTOR FROMINSTANCE="RTR_POLICY_CHECK" FROMINSTANCETYPE="Router" FROMFIELD="POLICY_KEY1" TOINSTANCE="FACT_CLAIMS" TOINSTANCETYPE="Target Definition" TOFIELD="POLICY_KEY"/>
    <CONNECTOR FROMINSTANCE="RTR_POLICY_CHECK" FROMINSTANCETYPE="Router" FROMFIELD="O_AGENT_KEY1" TOINSTANCE="FACT_CLAIMS" TOINSTANCETYPE="Target Definition" TOFIELD="AGENT_KEY"/>
    <CONNECTOR FROMINSTANCE="RTR_POLICY_CHECK" FROMINSTANCETYPE="Router" FROMFIELD="O_IS_LARGE_LOSS1" TOINSTANCE="FACT_CLAIMS" TOINSTANCETYPE="Target Definition" TOFIELD="IS_LARGE_LOSS"/>
